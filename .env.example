# Ayatiworks Tech/CRM/PMS Backend Configuration
# Copy this file to .env and update with your actual values

# ===========================================
# REQUIRED - Application will not start without these
# ===========================================

# Database Connection
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/ayatiworks_tech

# JWT Secret Key - GENERATE A NEW ONE!
# Run: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_KEY

# ===========================================
# SERVER CONFIGURATION
# ===========================================
HOST=0.0.0.0
PORT=8000
DEBUG=false
ENVIRONMENT=development

# ===========================================
# SECURITY
# ===========================================
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Origins (JSON array format)
CORS_ORIGINS=["https://admin.ayatiworks.com","http://localhost:3000","http://127.0.0.1:3000"]

# ===========================================
# EMAIL SMTP (Required for notifications)
# ===========================================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Ayatiworks Tech
SMTP_USE_TLS=true
FRONTEND_URL=https://admin.ayatiworks.com
ADMIN_URL=https://admin.ayatiworks.com
COMPANY_NAME=Ayatiworks Technologies
COMPANY_WEBSITE=https://ayatiworks.com
SUPPORT_EMAIL=support@example.com
HR_EMAIL=hr@example.com

# ===========================================
# OPTIONAL - OpenAI / Bot AI
# ===========================================
# Add your OpenAI API key to enable real bot LLM + RAG responses
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_RESPONSE_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
BOT_RAG_TOP_K=4
BOT_RAG_CHUNK_SIZE=800
BOT_RAG_CHUNK_OVERLAP=120

# ===========================================
# FILE STORAGE
# ===========================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# Optional ImageKit storage. When IMAGEKIT_PRIVATE_KEY is set, uploads go to
# IMAGEKIT_BASE_FOLDER/images, /documents, /profile, and /resumes.
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_PUBLIC_KEY=your-imagekit-public-key
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key
IMAGEKIT_BASE_FOLDER=/ayati-admin

# ===========================================
# EMPLOYEE ID CONFIGURATION
# ===========================================
EMPLOYEE_ID_PREFIX=AW
EMPLOYEE_ID_LENGTH=4

# ===========================================
# OPTIONAL - Redis (for caching/rate limiting)
# ===========================================
# REDIS_URL=redis://localhost:6379/0

# ===========================================
# OPTIONAL - Sentry (error tracking)
# ===========================================
# SENTRY_DSN=https://xxx@sentry.io/xxx
